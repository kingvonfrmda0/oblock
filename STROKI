char to_lower(char c) {
    unsigned char uc = c;
    if (uc >= 0xC0 && uc <= 0xDF) return uc + 32;
    if (uc == 0xA8) return 0xB8;
    return uc;
}

bool is_letter(char c) {
    unsigned char uc = to_lower(c);
    return (uc >= 0xE0 && uc <= 0xFF) || uc == 0xB8;
}

bool is_digit(char c) {
    return c >= '0' && c <= '9';
}

bool is_abc(std::string s) {
    if (s.length() <= 1) return true;
    for (size_t i = 1; i < s.length(); i++) {
        unsigned char prev = to_lower(s[i - 1]);
        unsigned char curr = to_lower(s[i]);
        if (prev == 0xB8) prev = 0xE5 + 1;
        if (curr == 0xB8) curr = 0xE5 + 1;
        if (curr < prev) return false;
    }
    return true;
}

std::string clean_word(std::string raw) {
    int start = 0;
    int end = static_cast<int>(raw.length()) - 1;
    while (start <= end) {
        if (is_letter(raw[start]) || is_digit(raw[start])) break;
        start++;
    }
    while (end >= start) {
        if (is_letter(raw[end])) break;
        end--;
    }
    if (start > end || !is_letter(raw[end])) return "";
    return raw.substr(start, end - start + 1);
}

bool is_equal(std::string s1, std::string s2) {
    if (s1.length() != s2.length()) return false;
    for (size_t i = 0; i < s1.length(); i++) {
        if (to_lower(s1[i]) != to_lower(s2[i])) return false;
    }
    return true;
}

// Функция вывода строки таблицы (символ и его код)
void print_row(char c) {
    // Выводим символ и его код в декомпрессированном виде (0-255)
    std::cout << "  " << c << "   |  " << std::setw(3) << static_cast<int>(static_cast<unsigned char>(c)) << "   ";
}

